<?xml version='1.1' encoding='UTF-8'?>
<project>
  <description>TP 3.3 : build, lancement du conteneur, test HTTP 200 (plugin HTTP Request), nettoyage.</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition><name>IMAGE_NAME</name><defaultValue>alpinehelloworld</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>IMAGE_TAG</name><defaultValue>latest</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition><name>Votre_ID_GIT</name><defaultValue>Legeni07</defaultValue><trim>true</trim></hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.plugins.git.GitSCM" plugin="git">
    <configVersion>2</configVersion>
    <userRemoteConfigs>
      <hudson.plugins.git.UserRemoteConfig><url>https://github.com/${Votre_ID_GIT}/alpinehelloworld.git</url></hudson.plugins.git.UserRemoteConfig>
    </userRemoteConfigs>
    <branches><hudson.plugins.git.BranchSpec><name>*/master</name></hudson.plugins.git.BranchSpec></branches>
    <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
    <submoduleCfg class="empty-list"/>
    <extensions/>
  </scm>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>#!/bin/bash
docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
docker rm -f ${IMAGE_NAME} || true
docker run -d -p 80:5000 -e PORT=5000 --name ${IMAGE_NAME} ${IMAGE_NAME}:${IMAGE_TAG}
sleep 5</command>
    </hudson.tasks.Shell>
    <jenkins.plugins.http__request.HttpRequest plugin="http_request">
      <url>http://172.17.0.1</url>
      <ignoreSslErrors>false</ignoreSslErrors>
      <httpMode>GET</httpMode>
      <passBuildParameters>false</passBuildParameters>
      <validResponseCodes>200</validResponseCodes>
      <validResponseContent></validResponseContent>
      <consoleLogResponseBody>false</consoleLogResponseBody>
      <quiet>false</quiet>
      <timeout>0</timeout>
      <useSystemProperties>false</useSystemProperties>
      <customHeaders/>
      <formData/>
      <wrapAsMultipart>true</wrapAsMultipart>
      <useNtlm>false</useNtlm>
    </jenkins.plugins.http__request.HttpRequest>
    <hudson.tasks.Shell>
      <command>#!/bin/bash
curl -s http://172.17.0.1 | grep -q "Hello world!"
docker stop ${IMAGE_NAME}
docker rm ${IMAGE_NAME}</command>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>
